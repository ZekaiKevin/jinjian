{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jinjian",
  "version": "0.9.0",
  "identifier": "com.zekaikevin.jinjian",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "今笺",
        "url": "index.html",
        "width": 928,
        "height": 900,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "capture",
        "title": "今笺 · 快速记录",
        "url": "capture.html",
        "width": 680,
        "height": 320,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
